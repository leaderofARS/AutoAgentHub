# === AI / Agent Backends ===
# Required for cloud Gemini agent & web-grounded news
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Agent backend: "auto" (uses Antigravity CLI `agy` if installed, else Gemini API), "agy", "gemini", or "custom"
AGENT_BACKEND=auto
AGY_SKIP_PERMISSIONS=true
AGY_TIMEOUT_SECONDS=300
# Optional custom CLI command template if AGENT_BACKEND=custom (use {prompt})
CUSTOM_AGENT_CMD=

# === GitHub ===
# Personal Access Token (repo, read:org) for inspecting repos, issues, PRs, and creating doc PRs
GITHUB_TOKEN=ghp_your_github_token_here
# Default repo in owner/repo format (e.g. octocat/Hello-World)
GITHUB_DEFAULT_REPO=owner/repo
# Optional secret for POST /webhook/github (@antigravity mentions in Issues/PRs)
GITHUB_WEBHOOK_SECRET=

# === Telegram ===
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated numeric Telegram user/chat IDs allowed to control your agents (leave empty to allow any, not recommended)
TELEGRAM_ALLOWED_CHAT_IDS=
# Default chat ID for daily automated alerts (jobs, repo health)
TELEGRAM_DEFAULT_CHAT_ID=
# Optional public base URL (e.g. https://autoagenthub.onrender.com) to use Telegram Webhook instead of polling
TELEGRAM_WEBHOOK_URL=

# === WhatsApp Cloud API (Meta) ===
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=autoagenthub_verify_123
WHATSAPP_DEFAULT_RECIPIENT=

# === Web Search (Optional, falls back to Gemini Search Grounding / DuckDuckGo) ===
TAVILY_API_KEY=

# === Job Finder Preferences ===
JOB_QUERY=software engineer python ai
JOB_LOCATION=remote
JOB_USER_NAME=Your Name
JOB_USER_BIO=Full-stack / AI engineer experienced in Python, TypeScript, and cloud automation.
# Daily schedule in 24h HH:MM (server timezone)
DAILY_JOBS_TIME=09:00
DAILY_REPO_CHECK_TIME=08:30

# === Server ===
PORT=8000
# Optional Bearer token to protect /api/os/* dashboard endpoints
DASHBOARD_API_TOKEN=

# === Concurrency, Queue & Resilience ===
WORKER_CONCURRENCY=4
MAX_QUEUE_SIZE=500
TASK_MAX_RETRIES=3
TASK_LEASE_SECONDS=120
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SEC=60
RATE_LIMIT_PER_MIN=30
